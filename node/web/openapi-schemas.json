  "IndexedEvent": {"allOf":[{"$ref":"#/components/schemas/Event"},{"type":"object","required":["transaction_index","transaction"],"properties":{"transaction_index":{"type":"integer","minimum":0},"transaction":{"$ref":"#/components/schemas/Hash"}}}]},
  "EventPage": {"type":"object","required":["items","from","next","tip"],"properties":{"items":{"type":"array","items":{"type":"object","required":["height","block","timestamp","events"],"properties":{"height":{"type":"integer"},"block":{"$ref":"#/components/schemas/Hash"},"timestamp":{"type":"integer","minimum":0},"events":{"type":"array","items":{"$ref":"#/components/schemas/IndexedEvent"}}}}},"from":{"type":"integer"},"next":{"type":"integer"},"tip":{"$ref":"#/components/schemas/Hash"}}},
