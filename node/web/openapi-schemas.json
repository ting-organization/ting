  "Submission": {"type":"object","required":["hex"],"additionalProperties":false,"properties":{"hex":{"type":"string","pattern":"^([0-9a-f]{2})*$","description":"Canonical binary encoding, represented as lowercase hex"},"not_before":{"type":"integer","minimum":0,"description":"Defer: hold the transaction until this Unix time, then admit it to the pool once it executes successfully on the tip. At most a year ahead; dropped a month after this time if never included"}}},
