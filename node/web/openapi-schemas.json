  "Mempool": {"type":"object","required":["items","bytes","deferred"],"properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/PoolEntry"}},"bytes":{"type":"integer","minimum":0},"deferred":{"type":"array","description":"Transactions held until due, not yet in the pool or awaiting a block","items":{"$ref":"#/components/schemas/PoolEntry"}}}},
  "Manifest": {"type":"object","required":["id","code_hash","code_bytes","state_root"],"properties":{"id":{"$ref":"#/components/schemas/Hash"},"code_hash":{"$ref":"#/components/schemas/Hash"},"code_bytes":{"type":"integer","minimum":1},"state_root":{"$ref":"#/components/schemas/Hash"}}},
"StorageProof": {"type":"object","required":["record_key","end","siblings"],"description":"A Merkle proof of the record against state_root (wiki: data/state-tree#proofs)","properties":{"record_key":{"$ref":"#/components/schemas/Hash"},"end":{"enum":["present","empty","other"],"description":"Where the key's path ends: the record's own leaf, an empty subtree, or another record's leaf"},"other_key":{"$ref":"#/components/schemas/Hash"},"other_value_hex":{"type":"string","pattern":"^([0-9a-f]{2})*$","description":"For other: that record's value, from which the verifier hashes its leaf"},"siblings":{"type":"array","items":{"$ref":"#/components/schemas/Hash"},"description":"The other child's hash at each level, from the end of the path up to the root"}}},
  "StorageReads": {"type":"object","required":["reads"],"additionalProperties":false,"properties":{"proof":{"type":"boolean","default":false,"description":"Also each record's Merkle proof"},"reads":{"type":"array","minItems":1,"maxItems":1024,"items":{"type":"object","required":["contract","key"],"additionalProperties":false,"properties":{"contract":{"$ref":"#/components/schemas/Hash"},"key":{"$ref":"#/components/schemas/Hash"}}}}}},
  "StorageValues": {"type":"object","required":["values","state_root","tip"],"properties":{"values":{"type":"array","items":{"type":"object","required":["contract","key","value_hex"],"properties":{"contract":{"$ref":"#/components/schemas/Hash"},"key":{"$ref":"#/components/schemas/Hash"},"value_hex":{"type":["string","null"],"pattern":"^([0-9a-f]{2})*$","description":"Null means absent; empty string is a present empty record"},"proof":{"$ref":"#/components/schemas/StorageProof"}}}},"state_root":{"$ref":"#/components/schemas/Hash"},"tip":{"$ref":"#/components/schemas/Hash"}}},
  "Storage": {"type":"object","required":["contract","key","value_hex","state_root"],"properties":{"contract":{"$ref":"#/components/schemas/Hash"},"key":{"$ref":"#/components/schemas/Hash"},"value_hex":{"type":["string","null"],"pattern":"^([0-9a-f]{2})*$","description":"Null means absent; empty string is a present empty record"},"state_root":{"$ref":"#/components/schemas/Hash"},"tip":{"$ref":"#/components/schemas/Hash"},"proof":{"$ref":"#/components/schemas/StorageProof"}}}
