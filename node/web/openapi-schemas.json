  "Deferred": {"type":"object","required":["not_before","expires","admitted"],"properties":{"not_before":{"type":"integer","minimum":0},"expires":{"type":"integer","minimum":0},"admitted":{"type":"boolean","description":"Executed successfully on the tip and now in the pool, awaiting a block"},"last_attempt":{"type":["integer","null"],"minimum":0},"last_result":{"type":["string","null"],"description":"Receipt status of the last failed execution on the tip; null when it succeeded or was never tried"}}},
