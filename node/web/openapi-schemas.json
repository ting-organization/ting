      "from":{"type":"integer","minimum":0},"next":{"type":"integer","minimum":0},"has_more":{"type":"boolean"},"tip":{"$ref":"#/components/schemas/Hash"},"occurrences":{"type":"array","items":{"$ref":"#/components/schemas/Occurrence"}}
