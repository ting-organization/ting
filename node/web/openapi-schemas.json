  "Occurrence": {"type":"object","required":["block","height","index","receipt","hex","transaction"],"properties":{"block":{"$ref":"#/components/schemas/Hash"},"height":{"type":"integer","minimum":1},"index":{"type":"integer","minimum":0},"receipt":{"$ref":"#/components/schemas/Receipt"},"hex":{"anyOf":[{"type":"string","pattern":"^([0-9a-f]{2})*$"},{"type":"null"}],"description":"The canonical envelope in hex; null for one larger than 1 MiB, which is read from its block in slices"},"transaction":{"$ref":"#/components/schemas/EnvelopeSummary"}}},
